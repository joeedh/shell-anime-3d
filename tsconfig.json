{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "jsxFactory": "jsx",
    "jsxFragmentFactory": "Fragment",
    "lib": ["esnext", "DOM", "DOM.Iterable", "esnext.disposable"],
    "types": ["@webgpu/types", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "src/**/*.d.ts"]
}
